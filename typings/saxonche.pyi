# The part of saxonche's API Haflinger uses; the package ships no type information.

class PySaxonApiError(Exception): ...
class PyXdmNode: ...

class PyXsltExecutable:
    def transform_to_string(self, *, xdm_node: PyXdmNode) -> str | None: ...

class PyXslt30Processor:
    def compile_stylesheet(
        self, *, stylesheet_file: str = ..., stylesheet_text: str = ...
    ) -> PyXsltExecutable: ...
    def set_cwd(self, cwd: str) -> None: ...

class PySaxonProcessor:
    def __init__(self, *, license: bool) -> None: ...
    def new_xslt30_processor(self) -> PyXslt30Processor: ...
    def set_configuration_property(self, name: str, value: str) -> None: ...
    def parse_xml(self, *, xml_file_name: str = ..., xml_text: str = ...) -> PyXdmNode: ...
